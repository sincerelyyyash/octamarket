# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/octamarkets"

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="./logs/indexer.log"

# Required API Keys
THEGRAPH_API_KEY="your_thegraph_api_key_here"

# Optional API Keys (some sources work without authentication)
KALSHI_API_KEY="your_kalshi_api_key_here"
KALSHI_PASSWORD="your_kalshi_password_here"

# RPC URLs for blockchain sources
OPTIMISM_RPC_URL="https://mainnet.optimism.io"
ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/your_infura_key"

# Source-specific configuration (optional overrides)
POLYMARKET_REST_ENDPOINT="https://gamma-api.polymarket.com"
POLYMARKET_WS_ENDPOINT="wss://ws-subscriptions-clob.polymarket.com/ws/market"

KALSHI_REST_ENDPOINT="https://api.elections.kalshi.com"
KALSHI_WS_ENDPOINT="wss://trading-api.kalshi.com/trade-api/ws/v2"

AUGUR_GRAPHQL_ENDPOINT="https://api.thegraph.com/subgraphs/name/augurproject/augur-mainnet"

THALES_REST_ENDPOINT="https://api.thalesmarket.io"
THALES_CONTRACT_ADDRESS="0x278b5a44397c9d8e52743fedec263c4760dc1a2a"

OMEN_GRAPHQL_ENDPOINT="https://api.thegraph.com/subgraphs/name/protofire/omen"

# Application Configuration
NODE_ENV="development"
