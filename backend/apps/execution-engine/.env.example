# Logging Configuration
LOG_LEVEL=info
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Streams Configuration
TRADES_INTENTS_STREAM=trades.intents
TRADES_DLQ_STREAM=trades.dlq
TRADES_CONSUMER_GROUP=engine-workers
TRADES_CONSUMER_NAME=engine-1
TRADES_VISIBILITY_MS=30000

# Server Configuration
SERVER_BASE_URL=http://localhost:3001
SERVER_INTERNAL_TOKEN=your-internal-token-here

# Signer Service Configuration
SIGNER_BASE_URL=http://localhost:8081
SIGNER_MTLS=false
SIGNER_TOKEN=your-signer-token-here
